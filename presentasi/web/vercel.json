{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/data",
      "destination": "/data.html"
    },
    {
      "source": "/data-interaktif",
      "destination": "/data.html"
    }
  ]
}